    {
        "id": "n3_tpl_alarmes",
        "type": "ui-template",
        "z": "tab_dashboard",
        "group": "grp_alarmes",
        "page": "",
        "ui": "",
        "name": "Estado da planta e alarmes",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"painel\">\n    <div class=\"estado\" :class=\"classeEstado\">{{ estado }}</div>\n    <div class=\"linha\">\n      Comunicação OPC UA:\n      <b :class=\"comOk ? 'ok' : 'nok'\">{{ comOk ? 'OK' : 'FALHA' }}</b>\n    </div>\n    <div class=\"linha\" v-if=\"msg?.payload?.timestamp\">\n      Última atualização: {{ new Date(msg.payload.timestamp).toLocaleTimeString('pt-BR') }}\n    </div>\n    <div v-if=\"alarmes.length === 0\" class=\"sem-alarme\">&#10004; Nenhum alarme ativo</div>\n    <ul v-else class=\"lista\">\n      <li v-for=\"a in alarmes\" :key=\"a.codigo\" :class=\"a.severidade\">{{ a.mensagem }}</li>\n    </ul>\n  </div>\n</template>\n<script>\nexport default {\n  computed: {\n    estado () { return this.msg?.payload?.estadoPlanta || 'AGUARDANDO DADOS' },\n    comOk () { return this.msg?.payload ? this.msg.payload.comunicacaoOk : false },\n    alarmes () { return this.msg?.payload?.alarmes || [] },\n    classeEstado () {\n      const e = this.estado\n      if (e === 'NORMAL') return 'normal'\n      if (e === 'ALARME') return 'alarme'\n      if (e === 'AGUARDANDO DADOS') return 'aguardando'\n      return 'falha'\n    }\n  }\n}\n</script>\n<style scoped>\n.painel { width: 100%; }\n.estado { text-align: center; font-size: 1.4rem; font-weight: 700; padding: 10px; border-radius: 6px; color: #fff; margin-bottom: 8px; }\n.normal { background: #2e7d32; }\n.alarme { background: #ef6c00; }\n.falha { background: #c62828; animation: piscar 1s infinite; }\n.aguardando { background: #9e9e9e; }\n@keyframes piscar { 50% { opacity: .55; } }\n.linha { color: #555; font-size: .9rem; margin: 2px 0; }\n.ok { color: #2e7d32; }\n.nok { color: #c62828; }\n.sem-alarme { margin-top: 10px; padding: 8px; border-radius: 4px; background: #e8f5e9; color: #2e7d32; }\n.lista { list-style: none; padding: 0; margin: 10px 0 0 0; }\n.lista li { padding: 8px; border-radius: 4px; margin-bottom: 6px; font-weight: 600; }\n.lista li.alarme { background: #fff3e0; color: #e65100; border-left: 5px solid #ef6c00; }\n.lista li.falha { background: #ffebee; color: #b71c1c; border-left: 5px solid #c62828; }\n</style>",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 330,
        "y": 440,
        "wires": [
            []
        ]
    },
    {
        "id": "n3_notif_fn",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Novo alarme? (pop-up)",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 500,
        "wires": [
            [
                "n3_notif"
            ]
        ],
        "func": "// Mostra um aviso apenas quando aparece um alarme que não estava ativo antes\nconst atuais = (msg.payload.alarmes || []).map(a => a.codigo);\nconst anteriores = context.get('anteriores') || [];\ncontext.set('anteriores', atuais);\nconst novos = (msg.payload.alarmes || []).filter(a => !anteriores.includes(a.codigo));\nif (!novos.length) return null;\nmsg.payload = novos.map(a => a.mensagem).join(' | ');\nreturn msg;"
    },
    {
        "id": "n3_notif",
        "type": "ui-notification",
        "z": "tab_dashboard",
