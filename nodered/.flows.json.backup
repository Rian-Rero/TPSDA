[
    {
        "id": "tab_aquisicao",
        "type": "tab",
        "label": "1 - Aquisição OPC UA e Lógica",
        "disabled": false,
        "info": "Lê as variáveis do Prosys OPC UA Simulation Server a cada 1 s, monta um único objeto com o estado do processo e aplica a lógica de alarmes."
    },
    {
        "id": "tab_mqtt",
        "type": "tab",
        "label": "2 - Publicação MQTT",
        "disabled": false,
        "info": "Publica no broker Mosquitto as medições, o status consolidado (JSON) e os alarmes."
    },
    {
        "id": "tab_dashboard",
        "type": "tab",
        "label": "3 - Dashboard e Comandos",
        "disabled": false,
        "info": "Dashboard de supervisão (FlowFuse Dashboard 2.0) e escrita de comandos no servidor OPC UA."
    },
    {
        "id": "tab_assinante",
        "type": "tab",
        "label": "4 - Assinante MQTT (verificação)",
        "disabled": false,
        "info": "O Node-RED também atuando como subscriber: assina os tópicos publicados para conferência na aba Debug."
    },
