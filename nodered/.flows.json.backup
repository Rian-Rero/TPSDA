    {
        "id": "n3_separar",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Separar valores",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 290,
        "y": 200,
        "outputLabels": [
            "nível",
            "temperatura",
            "vazão",
            "estado da bomba",
            "gráfico nível + limite",
            "limite nível alto"
        ],
        "wires": [
            [
                "n3_g_nivel"
            ],
            [
                "n3_g_temp",
                "n3_c_temp"
            ],
            [
                "n3_g_vazao",
                "n3_c_vazao"
            ],
            [
                "n3_tpl_bomba",
                "n3_rbe_bomba"
            ],
            [
                "n3_c_nivel"
            ],
            [
                "n3_rbe_limite"
            ]
        ],
        "func": "const s = msg.payload;\nif (!s.comunicacaoOk) return null;\nreturn [\n    { payload: s.nivel },\n    { payload: s.temperatura, topic: 'Temperatura' },\n    { payload: s.vazao, topic: 'Vazão' },\n    { payload: s.bombaLigada },\n    [ { payload: s.nivel, topic: 'Nível' }, { payload: s.limiteNivelAlto, topic: 'Limite nível alto' } ],\n    { payload: s.limiteNivelAlto }\n];"
    },
