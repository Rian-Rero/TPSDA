    {
        "id": "c1_titulo",
        "type": "comment",
        "z": "tab_aquisicao",
        "name": "Aquisição das variáveis via OPC UA (leitura cíclica, 1 s)",
        "info": "Os NodeIds ficam centralizados no nó \"Configuração dos NodeIds\".\nSe o seu Prosys gerar NodeIds diferentes, altere apenas esse nó.",
        "x": 260,
        "y": 40,
        "wires": []
    },
    {
        "id": "n1_inj_cfg",
        "type": "inject",
        "z": "tab_aquisicao",
        "name": "Ao iniciar",
        "props": [],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": "0.1",
        "topic": "",
        "x": 130,
        "y": 100,
        "wires": [
            [
                "n1_cfg"
            ]
        ]
    },
    {
        "id": "n1_cfg",
        "type": "function",
        "z": "tab_aquisicao",
        "name": "Configuração dos NodeIds",
        "outputs": 0,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 100,
        "wires": [],
        "func": "// Variáveis do Prosys OPC UA Simulation Server utilizadas no trabalho.\n// Objeto Processo > pastas Tanque01 e Bomba01 (namespace ns=3 do Prosys).\n// Se os NodeIds no seu servidor forem diferentes, altere SOMENTE aqui.\nglobal.set('opcua', {\n    nivel:           { nodeId: 'ns=3;s=Tanque01.Nivel',           tipo: 'Float'   }, // %       (leitura)\n    temperatura:     { nodeId: 'ns=3;s=Tanque01.Temperatura',     tipo: 'Float'   }, // °C      (leitura)\n    limiteNivelAlto: { nodeId: 'ns=3;s=Tanque01.LimiteNivelAlto', tipo: 'Int32'   }, // %       (leitura/escrita)\n    bombaLigada:     { nodeId: 'ns=3;s=Bomba01.Ligada',           tipo: 'Boolean' }, // on/off  (leitura/escrita)\n    vazao:           { nodeId: 'ns=3;s=Bomba01.Vazao',            tipo: 'Float'   }  // L/min   (leitura)\n});\nnode.status({ fill: 'green', shape: 'dot', text: 'NodeIds carregados' });\nreturn null;"
    },
    {
        "id": "n1_inj_ciclo",
        "type": "inject",
        "z": "tab_aquisicao",
        "name": "A cada 1 s",
        "props": [],
        "repeat": "1",
        "crontab": "",
        "once": true,
        "onceDelay": "2",
        "topic": "",
        "x": 130,
        "y": 180,
        "wires": [
            [
                "n1_lista"
            ]
        ]
    },
    {
        "id": "n1_lista",
        "type": "function",
        "z": "tab_aquisicao",
        "name": "Gerar pedidos de leitura",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 180,
        "wires": [
            [
                "n1_client_read"
            ]
        ],
        "func": "// Gera uma mensagem de leitura para cada variável configurada.\n// msg.topic = NodeId (é o que o nó OPC UA Client usa para ler)\nconst cfg = global.get('opcua');\nif (!cfg) return null;\nconst msgs = Object.keys(cfg).map(nome => ({\n    topic: cfg[nome].nodeId,\n    datatype: cfg[nome].tipo,\n    variavel: nome,\n    payload: ''\n}));\nreturn [msgs];"
    },
    {
        "id": "n1_client_read",
        "type": "OpcUa-Client",
        "z": "tab_aquisicao",
        "endpoint": "cfg_opcua_endpoint",
        "action": "read",
        "deadbandtype": "a",
        "deadbandvalue": 1,
        "time": 10,
        "timeUnit": "s",
        "certificate": "n",
        "localfile": "",
        "localkeyfile": "",
        "securitymode": "None",
        "securitypolicy": "None",
        "useTransport": false,
        "maxChunkCount": 1,
        "maxMessageSize": 8192,
        "receiveBufferSize": 8192,
        "sendBufferSize": 8192,
        "setstatusandtime": false,
        "keepsessionalive": false,
        "name": "Leitura OPC UA",
        "applicationName": "",
        "applicationUri": "",
        "x": 560,
        "y": 180,
        "wires": [
            [
                "n1_renomear"
            ],
            [
                "n1_filtro_erro"
            ],
            []
        ]
    },
    {
        "id": "n1_filtro_erro",
        "type": "switch",
        "z": "tab_aquisicao",
        "name": "Somente erros",
        "property": "error",
        "propertyType": "msg",
        "rules": [
            {
                "t": "nnull"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 1,
        "x": 790,
        "y": 240,
        "wires": [
            [
                "n1_debug_erro"
            ]
        ]
    },
    {
        "id": "n1_debug_erro",
        "type": "debug",
        "z": "tab_aquisicao",
        "name": "Erros OPC UA",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 990,
        "y": 240,
        "wires": []
    },
    {
        "id": "n1_renomear",
        "type": "change",
        "z": "tab_aquisicao",
        "name": "topic = nome da variável",
        "rules": [
            {
                "t": "set",
                "p": "topic",
                "pt": "msg",
                "to": "variavel",
                "tot": "msg"
            }
        ],
        "x": 790,
        "y": 180,
        "wires": [
            [
                "n1_join"
            ]
        ]
    },
    {
        "id": "n1_join",
        "type": "join",
        "z": "tab_aquisicao",
        "name": "Agrupar as 5 leituras",
        "mode": "custom",
        "build": "object",
        "property": "payload",
        "propertyType": "msg",
        "key": "topic",
        "joiner": "\\n",
        "joinerType": "str",
        "useparts": false,
        "accumulate": false,
        "timeout": "0.9",
        "count": "5",
        "reduceRight": false,
        "reduceExp": "",
        "reduceInit": "",
        "reduceInitType": "",
        "reduceFixup": "",
        "x": 1010,
        "y": 180,
        "wires": [
            [
                "n1_logica"
            ]
        ]
    },
    {
        "id": "c1_logica",
        "type": "comment",
        "z": "tab_aquisicao",
        "name": "Processamento: estados e alarmes inferidos a partir das variáveis",
        "info": "Critérios documentados no próprio nó e no relatório.",
        "x": 290,
        "y": 320,
        "wires": []
    },
    {
        "id": "n1_logica",
        "type": "function",
        "z": "tab_aquisicao",
        "name": "Lógica do processo (alarmes)",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 230,
        "y": 380,
        "wires": [
            [
                "n1_link_out",
                "n1_watchdog",
                "n1_debug_estado"
            ]
        ],
        "func": "// ------------------------------------------------------------------\n// Limites utilizados (justificativa no relatório)\nconst NIVEL_BAIXO        = 20;  // %      abaixo disso a bomba corre risco de operar a seco\nconst TEMP_MAXIMA        = 40;  // °C     operação normal simulada: 25 a 35 °C\nconst VAZAO_MINIMA       = 5;   // L/min  operação normal simulada: 12 a 16 L/min\nconst CICLOS_CONFIRMACAO = 3;   // leituras seguidas (~3 s) para confirmar falha de bombeamento\n// ------------------------------------------------------------------\n\nconst d = msg.payload;   // { nivel, temperatura, vazao, bombaLigada, limiteNivelAlto }\nconst faltando = ['nivel', 'temperatura', 'vazao', 'bombaLigada', 'limiteNivelAlto']\n    .filter(k => d[k] === undefined || d[k] === null);\nif (faltando.length) {\n    node.status({ fill: 'yellow', shape: 'ring', text: 'leitura incompleta: ' + faltando.join(', ') });\n    return null;\n}\nconst r1 = (x) => Math.round(Number(x) * 10) / 10;\nconst nivel = r1(d.nivel), temperatura = r1(d.temperatura), vazao = r1(d.vazao);\nconst bombaLigada = Boolean(d.bombaLigada);\nconst limiteNivelAlto = Number(d.limiteNivelAlto);\n\n// 1) Possível falha de bombeamento: bomba LIGADA e vazão abaixo do mínimo,\n//    confirmada por CICLOS_CONFIRMACAO leituras consecutivas.\nlet contador = context.get('contadorFalha') || 0;\ncontador = (bombaLigada && vazao < VAZAO_MINIMA) ? contador + 1 : 0;\ncontext.set('contadorFalha', contador);\nconst falhaBombeamento = contador >= CICLOS_CONFIRMACAO;\n\nconst alarmes = [];\nif (falhaBombeamento) alarmes.push({ codigo: 'FALHA_BOMBEAMENTO', severidade: 'falha',\n    mensagem: `Possível falha de bombeamento: bomba ligada com vazão de ${vazao} L/min (mínimo ${VAZAO_MINIMA} L/min)` });\n// 2) Nível alto: limite lido do próprio servidor OPC UA (ajustável pelo operador)\nif (nivel >= limiteNivelAlto) alarmes.push({ codigo: 'NIVEL_ALTO', severidade: 'alarme',\n    mensagem: `Nível alto: ${nivel} % (limite ${limiteNivelAlto} %)` });\n// 3) Nível baixo\nif (nivel <= NIVEL_BAIXO) alarmes.push({ codigo: 'NIVEL_BAIXO', severidade: 'alarme',\n    mensagem: `Nível baixo: ${nivel} % (limite ${NIVEL_BAIXO} %)` });\n// 4) Temperatura alta\nif (temperatura > TEMP_MAXIMA) alarmes.push({ codigo: 'TEMPERATURA_ALTA', severidade: 'alarme',\n    mensagem: `Temperatura alta: ${temperatura} °C (limite ${TEMP_MAXIMA} °C)` });\n\n// Estado geral da planta\nlet estadoPlanta = 'NORMAL';\nif (alarmes.length) estadoPlanta = 'ALARME';\nif (falhaBombeamento) estadoPlanta = 'FALHA';\n\nmsg.payload = {\n    timestamp: new Date().toISOString(),\n    nivel, temperatura, vazao, bombaLigada, limiteNivelAlto,\n    estadoBomba: bombaLigada ? 'LIGADA' : 'DESLIGADA',\n    estadoPlanta,\n    comunicacaoOk: true,\n    alarmes,\n    limites: { nivelBaixo: NIVEL_BAIXO, temperaturaMaxima: TEMP_MAXIMA, vazaoMinima: VAZAO_MINIMA }\n};\nnode.status({ fill: estadoPlanta === 'NORMAL' ? 'green' : 'red', shape: 'dot',\n    text: `${estadoPlanta} | N=${nivel}% T=${temperatura}°C Q=${vazao}L/min` });\nreturn msg;"
    },
    {
        "id": "n1_debug_estado",
        "type": "debug",
        "z": "tab_aquisicao",
        "name": "Estado do processo",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 500,
        "y": 440,
        "wires": []
    },
    {
        "id": "n1_watchdog",
        "type": "trigger",
        "z": "tab_aquisicao",
        "name": "Sem dados por 5 s?",
        "op1": "",
        "op2": "timeout",
        "op1type": "nul",
        "op2type": "str",
        "duration": "5",
        "extend": true,
        "overrideDelay": false,
        "units": "s",
        "reset": "",
        "bytopic": "all",
        "topic": "topic",
        "outputs": 1,
        "x": 500,
        "y": 500,
        "wires": [
            [
                "n1_semcom"
            ]
        ]
    },
    {
        "id": "n1_semcom",
        "type": "function",
        "z": "tab_aquisicao",
        "name": "Estado: sem comunicação",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 500,
        "wires": [
            [
                "n1_link_out"
            ]
        ],
        "func": "// Nenhuma leitura completa chegou nos últimos 5 s: servidor OPC UA parado ou inacessível.\nmsg.payload = {\n    timestamp: new Date().toISOString(),\n    estadoPlanta: 'SEM COMUNICAÇÃO',\n    comunicacaoOk: false,\n    alarmes: [{ codigo: 'FALHA_COMUNICACAO_OPCUA', severidade: 'falha',\n                mensagem: 'Sem leituras do servidor OPC UA há mais de 5 s' }]\n};\nnode.status({ fill: 'red', shape: 'ring', text: 'sem comunicação' });\nreturn msg;"
    },
    {
        "id": "n1_link_out",
        "type": "link out",
        "z": "tab_aquisicao",
        "name": "Estado do processo",
        "mode": "link",
        "links": [
            "n2_link_in",
            "n3_link_in"
        ],
        "x": 945,
        "y": 380,
        "wires": []
    },
    {
        "id": "c2_titulo",
        "type": "comment",
        "z": "tab_mqtt",
        "name": "Publicação no broker MQTT (Mosquitto)",
        "info": "Medições: QoS 0, sem retain (valor muda a cada segundo).\nStatus consolidado e alarmes: QoS 1, retain (novo assinante recebe o último estado na hora).",
        "x": 210,
        "y": 40,
        "wires": []
    },
    {
        "id": "n2_link_in",
        "type": "link in",
        "z": "tab_mqtt",
        "name": "Estado do processo",
        "links": [
            "n1_link_out"
        ],
        "x": 95,
        "y": 120,
        "wires": [
            [
                "n2_topicos",
                "n2_alarmes"
            ]
        ]
    },
    {
        "id": "n2_topicos",
        "type": "function",
        "z": "tab_mqtt",
        "name": "Medições e status (tópicos)",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 100,
        "wires": [
            [
                "n2_mqtt_out"
            ]
        ],
        "func": "const s = msg.payload;\nif (!s.comunicacaoOk) return null;   // sem dados novos para publicar\nconst base = 'fabrica/linha01';\nconst m = (topic, payload, qos, retain) => ({ topic, payload, qos, retain });\nreturn [[\n    m(`${base}/tanque01/nivel`,       s.nivel,       0, false),\n    m(`${base}/tanque01/temperatura`, s.temperatura, 0, false),\n    m(`${base}/bomba01/vazao`,        s.vazao,       0, false),\n    m(`${base}/bomba01/estado`,       s.estadoBomba, 1, true),\n    // payload estruturado com várias informações\n    m(`${base}/status`, {\n        timestamp: s.timestamp,\n        tanque01: { nivel: s.nivel, temperatura: s.temperatura, limiteNivelAlto: s.limiteNivelAlto },\n        bomba01:  { estado: s.estadoBomba, vazao: s.vazao },\n        estadoPlanta: s.estadoPlanta,\n        alarmesAtivos: s.alarmes.map(a => a.codigo)\n    }, 1, true)\n]];"
    },
    {
        "id": "n2_alarmes",
        "type": "function",
        "z": "tab_mqtt",
        "name": "Alarmes (somente na mudança)",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 160,
        "wires": [
            [
                "n2_mqtt_out",
                "n2_debug"
            ]
        ],
        "func": "// Publica em fabrica/linha01/alarmes apenas quando o conjunto de alarmes muda\n// (entrada ou saída de alarme), evitando repetir a mesma mensagem a cada segundo.\nconst s = msg.payload;\nconst assinatura = s.estadoPlanta + '|' + s.alarmes.map(a => a.codigo).sort().join(',');\nif (context.get('ultima') === assinatura) return null;\ncontext.set('ultima', assinatura);\nmsg.topic = 'fabrica/linha01/alarmes';\nmsg.qos = 1;\nmsg.retain = true;\nmsg.payload = {\n    timestamp: s.timestamp,\n    estadoPlanta: s.estadoPlanta,\n    quantidade: s.alarmes.length,\n    alarmes: s.alarmes\n};\nreturn msg;"
    },
    {
        "id": "n2_mqtt_out",
        "type": "mqtt out",
